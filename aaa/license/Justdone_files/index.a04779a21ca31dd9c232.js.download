ont-weight: 600 !important;\n    color: $white;\n\n    @include breakpoint(md) {\n      position: absolute;\n      right: 24px;\n      top: 24px;\n    }\n  }\n\n  &__title {\n    margin-bottom: 8px !important;\n    font-weight: 600 !important;\n    font-size: 18px !important;\n    color: $white;\n  }\n\n  &__button {\n    color: $black !important;\n    box-shadow: unset !important;\n  }\n}\n\n.price {\n  &__old {\n    display: inline-block;\n    position: relative;\n    color: $white;\n    opacity: 0.8;\n\n    &::after {\n      content: \'\';\n      position: absolute;\n      top: 50%;\n      transform: translateY(-50%);\n      left: 0;\n      height: 1px;\n      width: 100%;\n      background-color: $error-40;\n    }\n  }\n\n  &__current {\n    margin-bottom: 4px !important;\n    color: $white;\n    font-weight: 800 !important;\n  }\n\n  &__regularity {\n    color: $white;\n    opacity: 0.8;\n    margin-bottom: 16px !important;\n  }\n}\n\n.need_more {\n  @include flex();\n  gap: 4px;\n  margin-top: auto !important;\n\n  .text__link {\n    color: var(--color-custom-primary_40);\n    text-decoration: underline;\n    font-weight: 600;\n  }\n\n  @include breakpoint(md) {\n    align-items: center;\n    flex-direction: column;\n    margin-top: 10px !important;\n  }\n}\n\n.view_plans_link {\n  margin-top: auto;\n}',"$black: #000000;\r\n$white: #FFFFFF;\r\n\r\n$primary-20: #00164F;\r\n$primary-30: #13307E;\r\n$primary-35: #2F4990;\r\n$primary-40: #3B5AAE;\r\n$primary-50: #708DE4;\r\n$primary-60: #A5B8F4;\r\n$primary-80: #DBE1FF;\r\n$primary-90: #F2F4FF;\r\n\r\n$gradient-40: linear-gradient(90deg, #00B39B, #3B71F7);\r\n\r\n$error-20: #410001;\r\n$error-30: #7D0008;\r\n$error-40: #BF3C32;\r\n$error-45: #E24D39;\r\n$error-50: #FF8A7C;\r\n$error-60: #DF847D;\r\n$error-80: #FFDAD5;\r\n\r\n$neutral-20: #46474A;\r\n$neutral-30: #76777A;\r\n$neutral-40: #AEAFB1;\r\n$neutral-60: #DBDCDF;\r\n$neutral-80: #EEF0F5;\r\n$neutral-90: #FAFAFA;\r\n\r\n$warning-40: #F9E0A2;\r\n$warning-50: 