BAUI,cAAA,CACA,mBAAA,CAAA,CEhFF,0BFmFA,sBAEI,qBAAA,CAAA",sourcesContent:['@import "src/styles/colors";\n@import "src/styles/fonts";\n@import "src/styles/breakpoints";\n@import "src/styles/mixins";\n\n.item {\n  &__outer_wrapper {\n    position: relative;\n    cursor: pointer;\n    color: $black;\n    text-align: center;\n    margin-bottom: 15px;\n\n    @include breakpoint(md) {\n      margin-bottom: unset;\n    }\n\n    @media (hover: hover) {\n      &:hover, &:focus {\n        .item__inner_wrapper {\n          background: var(--color-custom-neutral_80);\n        }\n      }\n    }\n\n    &.is_active {\n      .item__inner_wrapper {\n        background-color: var(--color-custom-primary_80);\n      }\n\n      .item__title {\n        font-weight: 600;\n      }\n    }\n\n    &.is_active--sidekicker {\n      .item__inner_wrapper {\n        background-color: var(--color-custom-primary_40);\n      }\n    }\n  }\n\n  &__icon_container {\n    width: 24px;\n    height: 24px;\n\n    &__label {\n      position: absolute;\n      top: 2px;\n      right: 4px;\n\n      @include breakpoint(md) {\n        right: 0;\n      }\n    }\n  }\n\n  &__inner_wrapper {\n    @include flex($align: center, $justify: center);\n    margin-bottom: 5px;\n    padding: 4px;\n    border-radius: 16px;\n    min-height: 32px;\n    gap: 8px;\n    transition: background-color 250ms;\n\n    @include breakpoint(md) {\n      justify-content: flex-start;\n      padding: 16px;\n      border-radius: 100px;\n      min-height: 56px;\n    }\n\n    & svg {\n      width: 24px;\n      height: 24px;\n\n      @include breakpoint(md) {\n        margin-right: 14px;\n      }\n    }\n  }\n\n  &__title {\n    font-weight: 500;\n    font-size: 12px;\n    letter-spacing: 0.5px;\n    display: block;\n    color: var(--color-custom-neutral_20);\n    text-overflow: ellipsis;\n    overflow: hidden;\n\n    @include breakpoint(md) {\n      font-size: 14px;\n      letter-spacing: 0.1px;\n    }\n\n    &--white {\n      @include breakpoint