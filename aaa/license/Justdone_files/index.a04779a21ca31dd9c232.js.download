,0CAC+B,CAAA,4BChBjC,CAAA,oBACA,CAAA,qBACA,CAAA,mBACA,CAAA,sBDeE,eACE,CAAA,iBACA,CAAA,0CACA,CAAA,oBACA,CAAA,sBAIJ,YCpDiB,CAAA,kBDqDO,CAAA,wBAAkB,CAAA,cACxC,CAAA,sBAGF,cACE,CAAA,0BACA,CAAA,mBACA,CAAA,cACA,CAAA,0DACA,CAAA,+CACA,CAAA,+BAEA,yCACE,CAAA,+CACA,CAAA,sBAKJ,cACE,CAAA,0BACA,CAAA,cACA,CAAA,mCACA,CAAA,qBACA,CAAA,qBAEA,4BACE,mCACE,CAAA,8EACA,CAAA,CAAA,+BAIJ,wBACE,CAAA,6BACA,CAAA,sBAIJ,gBACE,CAAA,eACA,CAAA,0BAEA,UACkB,CAAA,WAAA,CAAA,sBAIpB,kBACE,CAAA,cACA,CAAA,UACA,CAAA,WACA,CAAA,2BAEA,yBACE,CAAA,sBAIJ,WACE,CAAA,sBAIJ,YCrHmB,CAAA,6BDsHO,CAAA,WACxB,CAAA,eACA,CAAA,iBACA,CAAA,oBACA,CAAA,0CAEA,SACE,CAAA,gDAGF,kBEtGW,CAAA,iBFwGT,CAAA,sBAIJ,YCtImB,CAAA,kBDuIK,CAAA,OACtB,CAAA,4BACA,CAAA,sBAGF,iBACE,CAAA,cACA,CAAA,4BAEA,kBACE,CAAA,iBACA,CAAA,cACA,CAAA,cACA,CAAA,WACA,CAAA,QACA,CAAA,0BACA",sourcesContent:['@import "src/styles/colors";\n@import "src/styles/mixins";\n@import "src/styles/breakpoints";\n\n.layout {\n  display: flex;\n  flex-grow: 1;\n  height: 100vh;\n\n  &__main {\n    @include flex($direction: column);\n    width: 100%;\n    background-color: $white;\n    overflow: hidden;\n  }\n}\n\n.header {\n  @include flex($align: center, $justify: space-between);\n  height: 100%;\n  max-height: 56px;\n  border-bottom: 1px solid $neutral-80;\n\n  &__logo_wrapper {\n    @include flex($align: center, $justify: center);\n  }\n\n  &__logo {\n    width: 100%;\n    max-width: 272px;\n    padding: 0 16px;\n\n    @include breakpoint(md) {\n      max-width: 160px;\n    }\n  }\n\n  &__unlimited_label {\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 24px;\n    letter-spacing: 0.15px;\n    @include backgroundClippedText(var(--color-custom-gradient_40));\n\n    &--sidekicker {\n      padding: 2px 4px;\n      border-radius: 4px;\n      background: var(--color-custom-gradient_20);\n      color: rgba(0,0,0, 0.6);\n    }\n  }\n\n  &__user {\n    @include flex($align: center, $justify: flex-end);\n    padding: 0 34px;\n  }\n\n  &__restore_button {\n    font-size: 14px;\n    font-weight: 500 !important;\n    letter-spacing: 0.1px;\n    padding: 0 24px;\n    background-color: var(--color-custom-primary_80) !important;\n    color: var(--color-custom-primary_20) !important;\n\n    &:disabled {\n      background-color: transparent !important;\n      color: var(--color-custom-primary_40) !important;\n    }\n  }\n\n\n  &__upgrade_button {\n    font-size: 14px;\n    font-weight: 600 !important;\n    padding: 0 24px;\n    background-color: $error-40 !important;\n    color: $white !important;\n\n    @media (hover: hover) {\n      &:hover {\n        background-color: $error-40 !important;\n        box-shadow: 0 1px 3px 1px rgba(0, 0, 0, 0.15), 0 1px 2px 0 rgba(0, 0, 0, 0.30) !important;\n      }\n    }\n\n    &:disabled {\n      color: $neutral-60 !important;\n      background: $neutral-80 !important;\n    }\n  }\n\n  &__account_icon {\n    line-height: 1.43;\n    font-weight: 500;\n\n    svg {\n      @include square(18px);\n    }\n  }\n\n  &__avatar {\n    margin-right: unset;\n    cursor: pointer;\n    width: 40px;\n    height: 40px;\n\n    & > span {\n      font-size: 14px !important;\n    }\n  }\n\n  &__nav_list {\n    width: 280px;\n  }\n}\n\n.content {\n  @include flex($justify: space-between);\n  flex-grow: 1;\n  overflow: hidden;\n  overflow-y: scroll;\n  scrollbar-width: none;\n\n  ::-webkit-scrollbar {\n    width: 8px;\n  }\n\n  ::-webkit-scrollbar-thumb {\n    background: $neutral-80;\n    border-radius: 4px;\n  }\n}\n\n.buttons_panel {\n  @include flex($align: center);\n  gap: 8px;\n  margin-right: 24px !important;\n}\n\n.contributor {\n  position: relative;\n  cursor: pointer;\n\n  &:after {\n    white-space: nowrap;\n    position: absolute;\n    font-size: 20px;\n    content: \'🤜🤛\';\n    bottom: -8px;\n    left: 50%;\n    transform: translateX(-50%);\n  }\n}\n','@mixin flex($type: flex, $align: false, $justify: false, $direction: false) {\n  display: $type;\n  @if ($align) {\n    align-items: $align;\n  }\n  @if ($justify) {\n    justify-content: $justify;\n  }\n  @if ($direction) {\n    flex-direction: $direction;\n  }\n}\n\n@mixin square($size) {\n  width: $size;\n  height: $size;\n}\n\n@mixin circle($size) {\n  width: $size;\n  height: $size;\n  border-radius: 50%;\n}\n\n@mixin backgroundClippedText($background) {\n  background: $background;\n  -webkit-background-clip: text;\n  background-clip: text;\n  background-size: cover;\n  color: transparent;\n}\n\n@mixin ignoreParentsWidth() {\n  width: 100vw;\n  margin-left: calc(50% - 50vw);\n}\n\n@mixin css-arrow($height: 10px, $border: 2px, $color: #efefef, $border-color: #999, $direction: bottom, $outside: true) {\n  $border-shift: $border;\n\n  @if $border > 0px {\n    $border: round($border * 1.41421356);\n  }\n\n  position: relative;\n\n  &:after,\n  &:before {\n    border: solid transparent;\n    content: " ";\n    display: block;\n    height: 0;\n    position: absolute;\n    pointer-events: none;\n    width: 0;\n\n    @if $direction == top {\n      @if $outside {\n        bottom: 100%;\n      }\n      @else {\n        margin-top: -$border-shift;\n        top: 0;\n      }\n    }\n    @if $direction == right {\n      @if $outside {\n        left: 100%;\n      }\n      @else {\n        margin-right: -$border-shift;\n        right: 0;\n      }\n    }\n    @if $direction == bottom {\n      @if $outside {\n        top: 100%;\n      }\n      @else {\n        bottom: 0;\n        margin-bottom: -$border-shift;\n      }\n    }\n    @if $direction == left {\n      @if $outside {\n        right: 100%;\n      }\n      @else {\n        left: 0;\n        margin-left: -$border-shift;\n      }\n    }\n  }\n\n  &:after {\n    border-color: rgba(255, 255, 255, 0);\n    @if $direction == top {\n      @if $outside {\n        border-bottom-color: $color;\n      }\n      @else {\n        border-top-color: $color;\n      }\n    }\n    @if $direction == right {\n      @if $outside {\n        border-left-color: $color;\n      }\n      @else {\n        border-right-color: $color;\n      }\n    }\n    @if $direction == bottom {\n      @if $outside {\n        border-top-color: $color;\n      }\n      @else {\n        border-bottom-color: $color;\n      }\n    }\n    @if $direction == left {\n      @if $outside {\n        border-right-color: $color;\n      }\n      @else {\n        border-left-color: $color;\n      }\n    }\n\n    @if $direction == top or $direction == bottom {\n      left: 50%;\n      margin-left: -$height;\n    }\n\n    @if $direction == left or $direction == right {\n      top: 50%;\n      margin-top: -$height;\n    }\n\n    border-width: $height;\n  }\n\n  &:before {\n    border-color: rgba(255, 255, 255, 0);\n    @if $direction == top {\n      @if $outside {\n        border-bottom-color: $border-color;\n      }\n      @else {\n        border-top-color: $border-color;\n      }\n    }\n    @if $direction == right {\n      @if $outside {\n        border-left-color: $border-color;\n      }\n      @else {\n        border-right-color: $border-color;\n      }\n    }\n    @if $direction == bottom {\n      @if $outside {\n        border-top-color: $border-color;\n      }\n      @else {\n        border-bottom-color: $border-color;\n      }\n    }\n    @if $direction == left {\n      @if $outside {\n        border-right-color: $border-color;\n      }\n      @else {\n        border-left-color: $border-color;\n      }\n    }\n\n    @if $direction == top or $direction == bottom {\n      left: 50%;\n      margin-left: -($height + $border);\n    }\n\n    @if $direction == left or $direction == right {\n      top: 50%;\n      margin-top: -($height + $border);\n    }\n\n    border-width: $height + $border;\n  }\n}\n',"$black: #000000;\r\n$white: #FFFFFF;\r\n\r\n$primary-20: #00164F;\r\n$primary-30: #13307E;\r\n$primary-35: #2F4990;\r\n$primary-40: #3B5AAE;\r\n$primary-50: #708DE4;\r\n$primary-60: #A5B8F4;\r\n$primary-80: #DBE1FF;\r\n$primary-90: #F2F4FF;\r\n\r\n$gradient-40: linear-gradient(90deg, #00B39B, #3B71F7);\r\n\r\n$error-20: #410001;\r\n$error-30: #7D0008;\r\n$error-40: #BF3C32;\r\n$error-45: #E24D39;\r\n$error-50: #FF8A7C;\r\n$error-60: #DF847D;\r\n$error-80: #FFDAD5;\r\n\r\n$neutral-20: #46474A;\r\n$neutral-30: #76777A;\r\n$neutral-40: #AEAFB1;\r\n$neutral-60: #DBDCDF;\r\n$neutral-80: #EEF0F5;\r\n$neutral-90: #FAFAFA;\r\n\r\n$warning-40: #F9E0A2;\r\n$warning-50: #F5D174;\r\n$warning-60: #EFB217;\r\n$warning-80: #FFEFC8;\r\n$warning-90: #FFF8E5;\r\n\r\n$yellow-30: #E19900;\r\n$yellow-60: #F9E0A2;\r\n\r\n$red-80: #FCEDEB;\r\n\r\n$green-30: #006B5D;\r\n$green-50: #00B39B;\r\n$green-70: #80D9CD;\r\n$green-90: #D8F0EB;\r\n\r\n$blue-40: #004EF8;\r\n","@mixin breakpoint($class) {\n  @if $class == xxs {\n    @media (max-width: 560px) {\n      @content;\n    }\n  }\n\n  @if $class == xs {\n    @media (max-width: 719px) {\n      @content;\n    }\n  }\n\n  @if $class == md {\n    @media (max-width: 1023px) {\n      @content;\n    }\n  }\n\n  @if $class == l {\n    @media (max-width: 1279px) {\n      @content;\n    }\n  }\n\n  @if $class == xl {\n    @media (max-width: 1439px) {\n      @content;\n    }\n  }\n\n  @if $class == xxl {\n    @media (max-width: 1919px) {\n      @content;\n    }\n  }\n}\n"],sourceRoot:""}]),a.locals={layout:"tQvM1Z7xeIimAnok32KZ",layout__main:"w6YPZBgcuPybMIAqFfbp",header:"xUDnZmHrYMP37kz3Xcr9",header__logo_wrapper:"Ryit8N4BBGw6Mf4fkr1o",header__logo:"YPaLzdsZbABITQJMZlKU",header__unlimited_label:"jVdShi4fdnqDLvylOqvU","header__unlimited_label--sidekicker":"uVnBAUAij9oDxUf1pfF_",header__user:"EWdLHC2ZSuCwzbUmFOXr",header__restore_button:"qW_H3bO5Yhf85js6Vu7O",header__upgrade_button:"v5jolx8cP70BqPr_AP1p",header__account_icon:"Qwfu7TOv25f69nLat9lq",header__avatar:"kj3NPLgQL8RHr6shrRO0",header__nav_list:"THo51uthZ0mtw0PTfZHa",content:"H5jim2McK8arrTokyxPn",buttons_panel:"zWSAi5p0_XNQ2wbMFniP",contributor:"unNRbC8QsolMFX45Pg_S"};const s=a},68531:(e,t,n)=>{"use strict";n.d(t,{A:()=>s});var r=n(71354),o=n.n(r),i=n(76314),a=n.n(i)()(o());a.push([e.id,".y8TuNsYyWTLn