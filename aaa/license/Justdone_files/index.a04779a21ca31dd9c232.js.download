k externalities, and path dependence.Great Britain accidentally adopted a de facto gold standard in 1717 when Isaac Newton, then-master of the Royal Mint, set the exchange rate of silver to gold too low, thus causing silver coins to go out of circulation. As Great Britain became the world's leading financial and commercial power in the 19th century, other states increasingly adopted Britain's monetary system.\n\nThe gold standard was largely abandoned during the Great Depression before being reinstated in a limited form as part of the post-World War II Bretton Woods system. The gold standard was abandoned due to its propensity for volatility, as well as the constraints it imposed on governments: by retaining a fixed exchange rate, governments were hamstrung in engaging in expansionary policies to, for example, reduce unemployment during economic recessions.",is_contain_quotes:!1,summary:"Gold standard.",ai_detector_execution:null,created_at:"2025-02-18T18:19:01.283396Z",updated_at:"2025-02-18T18:19:01.283396Z",demo_mode:!0};const l=t.IsShowedPlagiarismTutorial="is_showed_plagiarism_tutorial";t.getPlagiarismHighlightConfig=e=>({[o.HIGHLIGHT.PLAGIARISM_SIMPLIFIED_SCAN]:{title:e("highlight:plagiarism.simplified_scan.title","Exclude From Scanning"),text:e("highlight:plagiarism.simplified_scan.text","The plagiarism checker will not flag these parts of texts as not unique"),placement:"bottom-start",buttonText:e("general:next","Next"),onShowCallBack:()=>{i.default.trackEvent("tutorial - show tip",{tool:s,tip_number:2})},onSubmitCallback:()=>{i.default.trackEvent("tutorial - click next",{tool:s,tip_number:2})}},[o.HIGHLIGHT.PLAGIARISM_REMOVE_PLAGIARISM_BUTTON]:{title:e("highlight:plagiarism.remove_plagiarism.title","Remove Plagiarism"),text:e("highlight:plagiarism.remove_plagiarism.text","Use this feature to remove traces of plagiarism in your text to make it unique"),placement:"bottom-start",buttonText:e("general:next","Next"),onShowCallBack:()=>{i.default.trackEvent("tutorial - show tip",{tool:s,tip_number:3})},onSubmitCallback:()=>{i.default.trackEvent("tutorial - click next",{tool:s,tip_number:3})}},[o.HIGHLIGHT.PLAGIARISM_DETAILED_REPORT_BUTTON]:{title:e("highlight:plagiarism.detailed_report.title","Detailed Report"),text:e("highlight:plagiarism.detailed_report.text","Get a document with complete information about the text regarding plagiarism content inside"),placement:"bottom-start",buttonText:e("general:finish","Finish"),onShowCallBack:()=>{i.default.trackEvent("tutorial - show tip",{tool:s,tip_number:4})},onSubmitCallback:e=>{e({highlights:{[l]:!0}}),i.default.trackEvent("tutorial - finished",{tool:s})}}})},29874:(e,t,n)=>{"use strict";Object.defineProperty(t,"__esModule",{value:!0}),t.getPlagiarismWordsBalance=t.getPlagiarismResult=t.getPlagiarismInputLimits=t.getDetectionStage=t.calculateLoadingTime=void 0;var r=n(2758);t.getDetectionStage=e=>{const t=Object.entries(r.DETECTION_EDGE).sort(((e,t)=>{let[,n]=e,[,r]=t;return r-n})).find((t=>{let[,n]=t;return e>=n}));return t?t[0]:r.DETECTION_STAGE.LOW_LEVEL},t.calculateLoadingTime=e=>{if(e<=0)return 0;const t=24289*Math.log(e)-62028;return 1e3*Math.round(t/1e3)},t.getPlagiarismResult=e=>{const{identical_words:t,minor_changed_words:n,omitted_words:r}=e,o=t+n+r;return o>100?100:o},t.getPlagiarismWordsBalance=()=>3e4,t.getPlagiarismInputLimits=e=>{const{isAnnualSub:t,isNotPremium:n}=e;return{minCount:10,maxCount:n?15e3:t?5e4:15e3}}},72993:(e,t,n)=>{"use strict";var r=n(24994);Object.defineProperty(t,"__esModule",{value:!0}),t.getPlagiarismHighlightConfig=t.PlagiarismExampleShowedKey=t.PlagiarismCheckerTitle=t.PLAGIARISM_VALID_FILE_EXTENSIONS=t.PLAGIARISM_MAX_FILE_SIZE=t.IsShowedPlagiarismTutorial=t.EXAMPLE_RESPONSE=t.DETECTION_STAGE=t.DETECTION_EDGE=void 0;var o=n(44297),i=r(n(62893));t.PLAGIARISM_MAX_FILE_SIZE=2e7,t.PLAGIARISM_VALID_FILE_EXTENSIONS=["pdf","docx","txt"];let a=t.DETECTION_STAGE=function(e){return e.HIGH_LEVEL="high_level",e.PARTIAL_LEVEL="partial_level",e.HEALTHY_L