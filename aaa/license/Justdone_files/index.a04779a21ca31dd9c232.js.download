s/mixins';\n\n.card {\n  width: 364px;\n  color: $white;\n  border-radius: 4px;\n  padding: 10px 10px 10px 16px;\n\n  &.full_width {\n    width: 100%;\n  }\n}\n\n.flex_wrapper {\n  @include flex($align: center, $justify: space-between);\n  gap: 4px;\n}\n\n.optional_message {\n  font-weight: 400;\n  font-size: 14px;\n}\n\n.message {\n  font-size: 14px;\n  font-weight: 500;\n  line-height: 20px;\n}\n\n.close_button {\n  flex-shrink: 0;\n}\n\n.close_icon {\n  @include square(20px);\n\n  path {\n    fill: $white;\n  }\n}\n\n.accept_button {\n  width: 62px;\n  transform: translateX(32px);\n  font-size: 14px;\n  font-weight: 500;\n  line-height: 143%;\n  padding: 10px 12px;\n  margin-top: 12px;\n  margin-left: auto;\n  color: var(--color-custom-primary_40);\n}\n\n.report_button {\n  flex-shrink: 0;\n  font-weight: 600 !important;\n  padding: 10px 12px !important;\n  color: $error-20 !important;\n}\n\n.report_outer_block {\n  &.is_sent {\n    @include flex($align: center);\n    gap: 4px;\n\n    .report_inner_block {\n      margin-top: unset;\n      margin-left: auto;\n    }\n  }\n}\n\n.report_inner_block {\n  margin-top: 10px;\n  @include flex($justify: flex-end)\n}\n\n.forward_icon {\n  flex-shrink: 0;\n  @include square(24px)\n}\n\n.card.success {\n  @include flex($align: center);\n  gap: 12px;\n  background-color: $green-90;\n  color: $green-30;\n\n  .success_icon {\n    @include square(24px);\n  }\n\n  .close_icon, .success_icon {\n    path {\n      fill: $green-30;\n    }\n  }\n\n  .close_button {\n    &:hover {\n      background-color: rgba($black, 0.08) !important;\n    }\n  }\n}\n\n.card.info {\n  background-color: $neutral-20;\n\n  .close_button {\n    &:hover {\n      background-color: rgba($black, 0.08) !important;\n    }\n  }\n\n  .close_icon {\n    path {\n      fill: $neutral-80;\n    }\n  }\n\n  .message, .optional_message {\n    color: $neutral-80;\n  }\n}\n\n.card.system {\n  box-shadow: 0 2px 6px 2px rgba(0, 0, 0, 0.15), 0 1px 2px 0 rgba(0, 0, 0, 0.30);\n  background-color: $neutral-80;\n  border-radius: 12px;\n\n  .message, .optional_message {\n    color: $neutral-20;\n  }\n}\n\n.card.report, .card.error {\n  background-color: $error-80;\n  color: $error-20;\n\n  .close_button, .report_button {\n    &:hover {\n      background: $error-80 !important;\n    }\n  }\n\n  .close_icon {\n    path {\n      fill: $error-20;\n    }\n  }\n\n  .forward_icon {\n    margin-right: 8px;\n    path {\n      fill: $error-20;\n    }\n  }\n\n\n  .message, .optional_message {\n    color: $error-20;\n  }\n}\n\n","$black: #000000;\r\n$white: #FFFFFF;\r\n\r\n$primary-20: #00164F;\r\n$primary-30: #13307E;\r\n$primary-35: #2F4990;\r\n$primary-40: #3B5AAE;\r\n$primary-50: #708DE4;\r\n$primary-60: #A5B8F4;\r\n$primary-80: #DBE1FF;\r\n$primary-90: #F2F4FF;\r\n\r\n$gradient-40: linear-gradient(90deg, #00B39B, #3B71F7);\r\n\r\n$error-20: #410001;\r\n$error-30: #7D0008;\r\n$error-40: #BF3C32;\r\n$error-45: #E24D39;\r\n$error-50: #FF8A7C;\r\n$error-60: #DF847D;\r\n$error-80: #FFDAD5;\r\n\r\n$neutral-20: #46474A;\r\n$neutral-30: #76777A;\r\n$neutral-40: #AEAFB1;\r\n$neutral-60: #DBDCDF;\r\n$neutral-80: #EEF0F5;\r\n$neutral-90: #FAFAFA;\r\n\r\n$warning-40: #F9E0A2;\r\n$warning-50: #F5D174;\r\n$warning-60: #EFB217;\r\n$warning-80: #FFEFC8;\r\n$warning-90: #FFF8E5;\r\n\r\n$yellow-30: #E19900;\r\n$yellow-60: #F9E0A2;\r\n\r\n$red-80: #FCEDEB;\r\n\r\n$green-30: #006B5D;\r\n$green-50: #00B39B;\r\n$green-70: #80D9CD;\r\n$green-90: #D8F0EB;\r\n\r\n$blue-40: #004EF8;\r\n",'@mixin flex($type: flex, $align: false, $justify: false, $direction: false) {\n  display: $type;\n  @if ($align) {\n    align-items: $align;\n  }\n  @if ($justify) {\n    justify-content: $justify;\n  }\n  @if ($direction) {\n    flex-direction: $direction;\n  }\n}\n\n@mixin square($size) {\n  width: $size;\n  height: $size;\n}\n\n@mixin circle($size) {\n  width: $size;\n  height: $size;\n  border-radius: 50%;\n}\n\n@mixin backgroundClippedText($background) {\n  background: $background;\n  -webkit-background-clip: text;\n  background-clip: text;\n  background-size: cover;\n  color: transparent;\n}\n\n@mixin ignoreParentsWidth() {\n  width: 100vw;\n  margin-left: calc(50% - 50vw);\n}\n\n@mixin css-arrow($height: 10px, $border: 2px, $color: #efefef, $border-color: #999, $direction: bottom, $outside: true) {\n  $border-shift: $border;\n\n  @if $border > 0px {\n    $border: round($border * 1.41421356);\n  }\n\n  position: relative;\n\n  &:after,\n  &:before {\n    border: solid transparent;\n    content: " ";\n    display: block;\n    height: 0;\n    position: absolute;\n    pointer-events: none;\n    width: 0;\n\n    @if $direction == top {\n      @if $outside {\n        bottom: 100%;\n      }\n      @else {\n        margin-top: -$border-shift;\n        top: 0;\n      }\n    }\n    @if $direction == right {\n      @if $outside {\n        left: 100%;\n      }\n      @else {\n        margin-right: -$border-shift;\n        right: 0;\n      }\n    }\n    @if $direction == bottom {\n      @if $outside {\n        top: 100%;\n      }\n      @else {\n        bottom: 0;\n        margin-bottom: -$border-shift;\n      }\n    }\n    @if $direction == left {\n      @if $outside {\n        right: 100%;\n      }\n      @else {\n        left: 0;\n        margin-left: -$border-shift;\n      }\n    }\n  }\n\n  &:after {\n    border-color: rgba(255, 255, 255, 0);\n    @if $direction == top {\n      @if $outside {\n        border-bottom-color: $color;\n      }\n      @else {\n        border-top-color: $color;\n      }\n    }\n    @if $direction == right {\n      @if $outside {\n        border-left-color: $color;\n      }\n      @else {\n        border-right-color: $color;\n      }\n    }\n    @if $direction == bottom {\n      @if $outside {\n        border-top-color: $color;\n      }\n      @else {\n        border-bottom-color: $color;\n      }\n    }\n    @if $direction == left {\n      @if $outside {\n        border-right-color: $color;\n      }\n      @else {\n        border-left-color: $color;\n      }\n    }\n\n    @if $direction == top or $direction == bottom {\n      left: 50%;\n      margin-left: -$height;\n    }\n\n    @if $direction == left or $direction == right {\n      top: 50%;\n      margin-top: -$height;\n    }\n\n    border-width: $height;\n  }\n\n  &:before {\n    border-color: rgba(255, 255, 255, 0);\n    @if $direction == top {\n      @if $outside {\n        border-bottom-color: $border-color;\n      }\n      @else {\n        border-top-color: $border-color;\n      }\n    }\n    @if $direction == right {\n      @if $outside {\n        border-left-color: $border-color;\n      }\n      @else {\n        border-right-color: $border-color;\n      }\n    }\n    @if $direction == bottom {\n      @if $outside {\n        border-top-color: $border-color;\n      }\n      @else {\n        border-bottom-color: $border-color;\n      }\n    }\n    @if $direction == left {\n      @if $outside {\n        border-right-color: $border-color;\n      }\n      @else {\n        border-left-color: $border-color;\n      }\n    }\n\n    @if $direction == top or $direction == bottom {\n      left: 50%;\n      margin-left: -($height + $border);\n    }\n\n    @if $direction == left or $direction == right {\n      top: 50%;\n      margin-top: -($height + $border);\n    }\n\n    border-width: $height + $border;\n  }\n}\n'],sourceRoot:""}]),a.locals={card:"C1Qn8R3ZNP7fSVcqSrQf",full_width:"I4sa6nQx53ImNL9rVxui",flex_wrapper:"EgOfWgMFVTgfM2JHzoIg",optional_message:"Ed_SoNxR3gO0l0lSK1jL",message:"jLhzoP9eYsFZrFGVrY2y",close_button:"KguoZlqG9ANBF22X6RS8",close_icon:"Pg7QVrbDR5FgrXll1ojY",accept_button:"El_ooVlCDj0nD7bv7f4q",report_button:"nxT2xyH1JHGSQbvxdLOc",report_outer_block:"ejD6taEW3C97laJnKst4",is_sent:"JXD_s87oC9VCP8aYhV67",report_inner_block:"PdZxTbkmZ_XEI6GUbxa6",forward_icon:"j7uPqDQFdDYxA0wmnESH",success:"SCnim5VLwDrflpg4ECv1",success_icon:"TfvJXoVpwAXMTXt_3bhz",info:"wmyaoQmArzZqYJ00qzse",system:"ko74eTQNm8bTuE5zUaUe",report:"tU7AQHD76JU