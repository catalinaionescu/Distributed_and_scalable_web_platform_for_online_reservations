AA,CACA,kBE5GW,CF8GX,sBACE,cAAA,CACA,iBAAA,CACA,aErHS,CFuHT,kDAEE,WAAA,CAIJ,sBClJA,YADiB,CAGf,kBDiJsB,CC9ItB,sBD8IwC,CACxC,QAAA,CAGF,sBCvJA,YADiB,CAGf,kBDsJsB,CAGxB,sBACE,cAAA,CACA,eAAA,CACA,gBAAA,CACA,oBAAA,CCvIF,0CDwIiC,CCvIjC,4BAAA,CACA,oBAAA,CACA,qBAAA,CACA,mBAAA,CDsIE,sBACE,eAAA,CACA,iBAAA,CACA,0CAAA,CACA,oBAAA",sourcesContent:['@import "src/styles/breakpoints";\n@import "src/styles/mixins";\n@import "src/styles/vars";\n@import "src/styles/colors";\n\n.wrapper {\n  height: 100%;\n  @include flex($direction: column);\n}\n\n.sidebar {\n  background: $neutral-80;\n  overflow-y: scroll;\n  @include flex($direction: column);\n  flex-grow: 1;\n  height: 100%;\n  padding: 28px 8px;\n  width: 100px;\n  scrollbar-width: none;\n\n  @include breakpoint(md) {\n    background: $neutral-80;\n    width: 100%;\n    padding: 28px 8px 40px;\n  }\n\n  &::-webkit-scrollbar {\n    display: none;\n  }\n\n  &__flex_container {\n    display: flex;\n    flex-wrap: nowrap;\n    align-items: center;\n    max-width: 90%;\n  }\n\n  &__delimiter_container {\n    border-bottom: 1px solid $neutral-40;\n  }\n\n  &__account_row {\n    display: flex;\n    flex-wrap: nowrap;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 24px 28px 16px;\n    margin: 0 -12px;\n    border-bottom: 1px solid $neutral-40;\n\n    &__avatar {\n      margin-right: 24px;\n    }\n\n    &__title {\n      font-size: 14px;\n      font-weight: 500;\n      color: $neutral-20;\n\n      overflow: hidden;\n      white-space: nowrap;\n      text-overflow: ellipsis;\n    }\n\n    &__product_name {\n      font-size: 14px;\n      font-weight: 500;\n      background-color: transparent;\n      color: var(--color-custom-primary_40);\n    }\n\n    &__icon {\n      font-size: 18px;\n    }\n  }\n\n  &__restore_button {\n    font-size: 14px;\n    font-weight: 500;\n    letter-spacing: 0.1px;\n    background-color: var(--color-custom-primary_80) !important;\n    color: var(--color-custom-primary_20) !important;\n\n    &:disabled {\n      background-color: transparent !important;\n      color: var(--color-custom-primary_40) !important;\n    }\n  }\n\n  &__upgrade_button {\n    font-size: 14px;\n    font-weight: 600 !important;\n    padding: 0 24px;\n    background-color: $error-40 !important;\n    color: $white !important;\n\n    @media (hover: hover) {\n      &:hover {\n        background-color: $error-40 !important;\n        box-shadow: 0 1px 3px 1px rgba(0, 0, 0, 0.15), 0 1px 2px 0 rgba(0, 0, 0, 0.30) !important;\n      }\n    }\n\n    &:disabled {\n      color: $neutral-60 !important;\n      background: $neutral-80 !important;\n    }\n  }\n\n\n  &__items {\n    display: flex;\n    flex-direction: column;\n  }\n\n  &__title {\n    font-weight: 500;\n    font-size: 14px;\n    color: $black;\n    line-height: 40px;\n    padding: 8px 16px;\n  }\n}\n\n.buttons_panel {\n  margin-top: auto;\n}\n\n.header {\n  @include flex($align: center);\n  max-height: $header-mobile-height;\n  width: 100%;\n  gap: 12px;\n  padding: 12px 4px;\n  background: $neutral-80;\n\n  &__close_button {\n    font-size: 30px;\n    margin-right: 12px;\n    color: $neutral-20;\n\n    &,\n    &:hover {\n      border: none;\n    }\n  }\n\n  &__logo_wrapper {\n    @include flex($align: center, $justify: center);\n    gap: 12px;\n  }\n\n  &__logo {\n    @include flex($align: center);\n  }\n\n  &__unlimited_label {\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 24px;\n    letter-spacing: 0.15px;\n    @include backgroundClippedText(var(--color-custom-gradient_40));\n\n    &--sidekicker {\n      padding: 2px 4px;\n      border-radius: 4px;\n      background: var(--color-custom-gradient_20);\n      color: rgba(0,0,0, 0.6);\n    }\n  }\n}\n','@mixin flex($type: flex, $align: false, $justify: false, $direction: false) {\n  display: $type;\n  @if ($align) {\n    align-items: $align;\n  }\n  @if ($justify) {\n    justify-content: $justify;\n  }\n  @if ($direction) {\n    flex-direction: $direction;\n  }\n}\n\n@mixin square($size) {\n  width: $size;\n  height: $size;\n}\n\n@mixin circle($size) {\n  width: $size;\n  height: $size;\n  border-radius: 50%;\n}\n\n@mixin backgroundClippedText($background) {\n  background: $background;\n  -webkit-background-clip: text;\n  background-clip: text;\n  background-size: cover;\n  color: transparent;\n}\n\n@mixin ignoreParentsWidth() {\n  width: 100vw;\n  margin-left: calc(50% - 50vw);\n}\n\n@mixin css-arrow($height: 10px, $border: 2px, $color: #efefef, $border-color: #999, $direction: bottom, $outside: true) {\n  $border-shift: $border;\n\n  @if $border > 0px {\n    $border: round($border * 1.41421356);\n  }\n\n  position: relative;\n\n  &:after,\n  &:before {\n    border: solid transparent;\n    content: " ";\n    display: block;\n    height: 0;\n    position: absolute;\n    pointer-events: none;\n    width: 0;\n\n    @if $direction == top {\n      @if $outside {\n        bottom: 100%;\n      }\n      @else {\n        margin-top: -$border-shift;\n        top: 0;\n      }\n    }\n    @if $direction == right {\n      @if $outside {\n        left: 100%;\n      }\n      @else {\n        margin-right: -$border-shift;\n        right: 0;\n      }\n    }\n    @if $direction == bottom {\n      @if $outside {\n        top: 100%;\n      }\n      @else {\n        bottom: 0;\n        margin-bottom: -$border-shift;\n      }\n    }\n    @if $direction == left {\n      @if $outside {\n        right: 100%;\n      }\n      @else {\n        left: 0;\n        margin-left: -$border-shift;\n      }\n    }\n  }\n\n  &:after {\n    border-color: rgba(255, 255, 255, 0);\n    @if $direction == top {\n      @if $outside {\n        border-bottom-color: $color;\n      }\n      @else {\n        border-top-color: $color;\n      }\n    }\n    @if $direction == right {\n      @if $outside {\n        border-left-color: $color;\n      }\n      @else {\n        border-right-color: $color;\n      }\n    }\n    @if $direction == bottom {\n      @if $outside {\n        border-top-color: $color;\n      }\n      @else {\n        border-bottom-color: $color;\n      }\n    }\n    @if $direction == left {\n      @if $outside {\n        border-right-color: $color;\n      }\n      @else {\n        border-left-color: $color;\n      }\n    }\n\n    @if $direction == top or $direction == bottom {\n      left: 50%;\n      margin-left: -$height;\n    }\n\n    @if $direction == left or $direction == right {\n      top: 50%;\n      margin-top: -$height;\n    }\n\n    border-width: $height;\n  }\n\n  &:before {\n    border-color: rgba(255, 255, 255, 0);\n    @if $direction == top {\n      @if $outside {\n        border-bottom-color: $border-color;\n      }\n      @else {\n        border-top-color: $border-color;\n      }\n    }\n    @if $direction == right {\n      @if $outside {\n        border-left-color: $border-color;\n      }\n      @else {\n        border-right-color: $border-color;\n      }\n    }\n    @if $direction == bottom {\n      @if $outside {\n        border-top-color: $border-color;\n      }\n      @else {\n        border-bottom-color: $border-color;\n      }\n    }\n    @if $direction == left {\n      @if $outside {\n        border-right-color: $border-color;\n      }\n      @else {\n        border-left-color: $border-color;\n      }\n    }\n\n    @if $direction == top or $direction == bottom {\n      left: 50%;\n      margin-left: -($height + $border);\n    }\n\n    @if $direction == left or $direction == right {\n      top: 50%;\n      margin-top: -($height + $border);\n    }\n\n    border-width: $height + $border;\n  }\n}\n',"$black: #000000;\r\n$white: #FFFFFF;\r\n\r\n$primary-20: #00164F;\r\n$primary-30: #13307E;\r\n$primary-35: #2F4990;\r\n$primary-40: #3B5AAE;\r\n$primary-50: #708DE4;\r\n$primary-60: #A5B8F4;\r\n$primary-80: #DBE1FF;\r\n$primary-90: #F2F4FF;\r\n\r\n$gradient-40: linear-gradient(90deg, #00B39B, #3B71F7);\r\n\r\n$error-20: #410001;\r\n$error-30: #7D0008;\r\n$error-40: #BF3C32;\r\n$error-45: #E24D39;