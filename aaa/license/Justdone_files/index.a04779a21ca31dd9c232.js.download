rd {\n  position: relative;\n  border-radius: 16px;\n  background-color: $white;\n  box-shadow: 0 0 0 2px inset var(--color-custom-primary_80);\n  cursor: pointer;\n  transition: box-shadow 250ms, background-color 250ms;\n\n  @include breakpoint(l) {\n    width: 100%;\n  }\n\n  &.is_active {\n    box-shadow: 0 0 0 2px inset var(--color-custom-primary_40), 0 3px 4px 0 rgba(59, 90, 174, 0.30);\n    background-color: $white;\n\n    .checkbox {\n      background-color: var(--color-custom-primary_40);\n      box-shadow: 0 0 0 2px inset var(--color-custom-primary_40);\n\n      &__icon {\n        opacity: 1;\n      }\n    }\n\n    .price {\n      &__current {\n        color: var(--color-custom-primary_40);\n        font-weight: 500 !important;\n      }\n    }\n  }\n\n  &.is_accent {\n    .price__current {\n      color: $error-30\n    }\n  }\n\n  &.is_disabled {\n    pointer-events: none;\n    opacity: 0.7;\n\n    .checkbox {\n      box-shadow: 0 0 0 2px inset var(--color-custom-primary_50);\n    }\n\n    .title {\n      color: $neutral-30;\n    }\n  }\n\n  &.horizontal {\n    @include flex($align: center, $justify: space-between);\n    gap: 12px;\n    width: 100%;\n    padding: 18px 16px 18px 12px;\n    min-height: 96px;\n\n    .discount {\n      top: -10px;\n      right: 80px;\n    }\n\n    .price {\n      @include flex($direction: column, $align: flex-end);\n      margin-left: auto;\n    }\n  }\n\n  &.vertical {\n    @include flex($direction: column, $justify: flex-start);\n    gap: 8px;\n    height: 100%;\n    width: 100%;\n    padding: 22px 16px 22px 12px;\n\n    .discount {\n      top: -10px;\n      right: 18px;\n    }\n  }\n}\n\n.discount {\n  position: absolute;\n  z-index: 3;\n  padding: 4px 10px;\n  font-size: 12px;\n  font-weight: 600;\n  line-height: 20px;\n  letter-spacing: 0.1px;\n  background-color: $error-40;\n  color: $white;\n  border-radius: 28px;\n}\n\n.checkbox {\n  @include circle(22px);\n  @include flex($align: center, $justify: center);\n  flex-shrink: 0;\n  box-shadow: 0 0 0 2px inset $primary-20;\n  transition: box-shadow 250ms, background-color 250ms;\n\n  &__icon {\n    opacity: 0;\n    @include square(24px);\n    transition: opacity 250ms;\n  }\n}\n\n.title {\n  color: $primary-20;\n}\n\n.price {\n  &__old {\n    display: inline-block;\n    color: $neutral-30;\n    position: relative;\n    opacity: 0.8;\n\n    &::after {\n      content: \'\';\n      position: absolute;\n      top: 50%;\n      transform: translateY(-50%);\n      left: 0;\n      height: 1px;\n      width: 100%;\n      background-color: $error-40;\n    }\n  }\n\n  &__current {\n    color: var(--color-custom-primary_50);\n    font-weight: 500;\n    transition: color 250ms;\n  }\n\n  &__regularity {\n    opacity: 0.8;\n    color: $primary-20;\n  }\n}',"$black: #000000;\r\n$white: #FFFFFF;\r\n\r\n$primary-20: #00164F;\r\n$primary-30: #13307E;\r\n$primary-35: #2F4990;\r\n$primary-40: #3B5AAE;\r\n$primary-50: #708DE4;\r\n$primary-60: #A5B8F4;\r\n$primary-80: #DBE1FF;\r\n$primary-90: #F2F4FF;\r\n\r\n$gradient-40: linear-gradient(90deg, #00B39B, #3B71F7);\r\n\r\n$error-20: #410001;\r\n$error-30: #7D0008;\r\n$error-40: #BF3C32;\r\n$error-45: #E24D39;\r\n$error-50: #FF8A7C;\r\n$error-60: #DF847D;\r\n$error-80: #FFDAD5;\r\n\r\n$neutral-20: #46474A;\r\n$neutral-30: #76777A;\r\n$neutral-40: #AEAFB1;\r\n$neutral-60: #DBDCDF;\r\n$neutral-80: #EEF0F5;\r\n$neutral-90: #FAFAFA;\r\n\r\n$warning-40: #F9E0A2;\r\n$warning-50: #F5D174;\r\n$warning-60: #EFB217;\r\n$warning-80: #FFEFC8;\r\n$warning-90: #FFF8E5;\r\n\r\n$yellow-30: #E19900;\r\n$yellow-60: #F9E0A2;\r\n\r\n$red-80: #FCEDEB;\r\n\r\n$green-30: #006B5D;\r\n$green-50: #00B39B;\r\n$green-70: #80D9CD;\r\n$green-90: #D8F0EB;\r\n\r\n$blue-40: #004EF8;\r\n","@mixin breakpoint($class) {\n  @if $class == xxs {\n    @media (max-width: 560px) {\n      @content;\n    }\n  }\n\n  @if $class == xs {\n    @media (max-width: 719px) {\n      @content;\n    }\n  }\n\n  @if $class == md {\n    @media (max-width: 1023px) {\n