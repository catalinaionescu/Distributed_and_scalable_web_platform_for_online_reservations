rgin-bottom: 24px;\n\n    @include breakpoint(l) {\n      padding: 32px 16px;\n    }\n  }\n}\n\n.width_limit {\n  width: 100%;\n  max-width: 468px;\n}\n\n.textarea {\n  & > div {\n    background: $white;\n  }\n\n  & textarea {\n    font-size: 14px;\n    line-height: 20px;\n  }\n\n  & ::placeholder {\n    font-size: 14px;\n    line-height: 20px;\n    color: $neutral-20\n  }\n}\n\n.password {\n  &__input {\n    width: 100%;\n    max-width: 664px;\n\n    & > div {\n      background: $white;\n    }\n  }\n}\n\n.buttons {\n  @include flex();\n  gap: 16px;\n}\n\n.button {\n  font-weight: 600 !important;\n  padding: 14px 24px !important;\n\n  @include breakpoint(l) {\n    padding: 14px 16px !important;\n  }\n\n  &--discount {\n    @include flex($align: center);\n    gap: 8px;\n\n    .icon {\n      @include square(18px);\n      color: $warning-80;\n    }\n  }\n}\n','@mixin flex($type: flex, $align: false, $justify: false, $direction: false) {\n  display: $type;\n  @if ($align) {\n    align-items: $align;\n  }\n  @if ($justify) {\n    justify-content: $justify;\n  }\n  @if ($direction) {\n    flex-direction: $direction;\n  }\n}\n\n@mixin square($size) {\n  width: $size;\n  height: $size;\n}\n\n@mixin circle($size) {\n  width: $size;\n  height: $size;\n  border-radius: 50%;\n}\n\n@mixin backgroundClippedText($background) {\n  background: $background;\n  -webkit-background-clip: text;\n  background-clip: text;\n  background-size: cover;\n  color: transparent;\n}\n\n@mixin ignoreParentsWidth() {\n  width: 100vw;\n  margin-left: calc(50% - 50vw);\n}\n\n@mixin css-arrow($height: 10px, $border: 2px, $color: #efefef, $border-color: #999, $direction: bottom, $outside: true) {\n  $border-shift: $border;\n\n  @if $border > 0px {\n    $border: round($border * 1.41421356);\n  }\n\n  position: relative;\n\n  &:after,\n  &:before {\n    border: solid transparent;\n    content: " ";\n    display: block;\n    height: 0;\n    position: absolute;\n    pointer-events: none;\n    width: 0;\n\n    @if $direction == top {\n      @if $outside {\n        bottom: 100%;\n      }\n      @else {\n        margin-top: -$border-shift;\n        top: 0;\n      }\n    }\n    @if $direction == right {\n      @if $outside {\n        left: 100%;\n      }\n      @else {\n        margin-right: -$border-shift;\n        right: 0;\n      }\n    }\n    @if $direction == bottom {\n      @if $outside {\n        top: 100%;\n      }\n      @else {\n        bottom: 0;\n        margin-bottom: -$border-shift;\n      }\n    }\n    @if $direction == left {\n      @if $outside {\n        right: 100%;\n      }\n      @else {\n        left: 0;\n        margin-left: -$border-shift;\n      }\n    }\n  }\n\n  &:after {\n    border-color: rgba(255, 255, 255, 0);\n    @if $direction == top {\n      @if $outside {\n        border-bottom-color: $color;\n      }\n      @else {\n        border-top-color: $color;\n      }\n    }\n    @if $direction == right {\n      @if $outside {\n        border-left-color: $color;\n      }\n      @else {\n        border-right-color: $color;\n      }\n    }\n    @if $direction == bottom {\n      @if $outside {\n        border-top-color: $color;\n      }\n      @else {\n        border-bottom-color: $color;\n      }\n    }\n    @if $direction == left {\n      @if $outside {\n        border-right-color: $color;\n      }\n      @else {\n        border-left-color: $color;\n      }\n    }\n\n    @if $direction == top or $direction == bottom {\n      left: 50%;\n      margin-left: -$height;\n    }\n\n    @if $direction == left or $direction == right {\n      top: 50%;\n      margin-top: -$height;\n    }\n\n    border-width: $height;\n  }\n\n  &:before {\n    border-color: rgba(255, 255, 255, 0);\n    @if $direction == top {\n      @if $outside {\n        border-bottom-color: $border-color;\n      }\n      @else {\n        border-top-color: $border-color;\n      }\n    }\n    @if $direction == right {\n      @if $outside {\n        border-left-color: $border-color;\n      }